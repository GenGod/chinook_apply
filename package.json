{
  "name": "chinook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Chinook — Alberta job search automation (Express Entry)",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "pipeline:check": "node scripts/pipeline.mjs",
    "pipeline:quick": "node scripts/pipeline.mjs --quick",
    "lint": "eslint . && node scripts/check-colors.mjs",
    "arch-lint": "eslint . --config eslint.arch.config.js",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "e2e": "pnpm --filter @chinook/worker run seed:e2e && pnpm --filter @chinook/tests exec playwright test",
    "e2e:update-snapshots": "pnpm exec turbo run build --force && pnpm --filter @chinook/worker run seed:e2e && pnpm --filter @chinook/tests exec playwright test --update-snapshots",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chinook/eslint-plugin-arch": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
