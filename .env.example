# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
DATABASE_URL=postgres://chinook:chinook_dev@localhost:5433/chinook
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
# Politeness contact published in the crawler User-Agent (jobbank/adzuna).
# Leave empty to omit the contact clause from the UA entirely.
CRAWLER_CONTACT_EMAIL=
