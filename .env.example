# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
DATABASE_URL=postgres://chinook:chinook_dev@localhost:5433/chinook
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
# Politeness contact published in the crawler User-Agent (jobbank/adzuna).
# Leave empty to omit the contact clause from the UA entirely.
CRAWLER_CONTACT_EMAIL=

# S8 email dispatch. DISPATCH_MODE=dry-run (default) rewrites the SMTP envelope
# to dispatch-sink@localhost — mail cannot reach an employer. live requires
# SMTP_USER/SMTP_PASS (Gmail app password recommended; see specs/S8).
DISPATCH_MODE=dry-run
DISPATCH_DAILY_LIMIT=10
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bogdan Vetrenko <you@example.com>"

# S23 auto-draft (scheduler): draft resume+cover for fresh relevant jobs.
AUTO_DRAFT=1
AUTO_DRAFT_SCORE=85
AUTO_DRAFT_JOBS_PER_DAY=10
