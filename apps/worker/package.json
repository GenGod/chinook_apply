{
  "name": "@chinook/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=../../.env src/ingest.ts",
    "ingest:fixtures": "tsx --env-file-if-exists=../../.env src/ingest.ts --fixtures",
    "test": "vitest run",
    "schedule": "tsx src/scheduler.ts",
    "schedule:status": "tsx src/scheduler.ts --status",
    "schedule:once": "tsx src/scheduler.ts --once",
    "seed:e2e": "tsx src/seed-e2e.ts",
    "dev": "next dev"
  },
  "dependencies": {
    "@chinook/adapters": "workspace:*",
    "@chinook/contracts": "workspace:*",
    "@chinook/core": "workspace:*",
    "@chinook/llm": "workspace:*",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.5",
    "vitest": "^5.0.0"
  }
}
